# Copy to .env.local. Dev-only values, no secrets.
# Leave DATABASE_URL unset to use the in-memory adapter (ADR-010).
# Matches compose.yaml; start the database with `pnpm db:up`.
# DATABASE_URL=postgres://benefits:benefits@127.0.0.1:5432/benefits

# AI provider (ADR-005, ADR-007): "mock" (the default) or "anthropic".
# The anthropic provider needs a key; set it only in .env.local, never here.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Abort a model call after this many milliseconds (default 8000, a heuristic).
# AI_TIMEOUT_MS=8000
# Request limits (ADR-006): longest query in characters (default 200) and
# largest request body in bytes (default 4096). Both are heuristics.
# MAX_QUERY_CHARS=200
# MAX_BODY_BYTES=4096
# Model requests per client address per minute, applied only with
# AI_PROVIDER=anthropic (ADR-006; best effort, per server instance). Default 20.
# RATE_LIMIT_PER_MINUTE=20
